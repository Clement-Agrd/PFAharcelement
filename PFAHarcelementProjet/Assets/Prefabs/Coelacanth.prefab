  npcPortrait: {fileID: 21300000, guid: 0b7dc3e5d37ff0349ade7d201b2103dc, type: 3}
  npcName: Coelacanth
  dialogLines:
  - "L'oc\xE9an garde les secrets de ceux qui souffrent en silence..."
  - "Mais le silence a ses limites. Il est temps que ta voix r\xE9sonne comme une
    vague."
  - "Choisis bien, jeune requin. Ce pouvoir est n\xE9 de la douleur de ceux qui se
    sont relev\xE9s avant toi."
